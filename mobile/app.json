{
  "expo": {
    "name": "Nextrip",
    "slug": "nextrip",
    "scheme": "nextrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/nextrip-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nextrip.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.nextrip.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#173B66",
        "foregroundImage": "./assets/nextrip-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/nextrip-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173B66",
          "image": "./assets/nextrip-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#173B66",
            "image": "./assets/nextrip-logo.png"
          }
        }
      ]
    ]
  }
}
