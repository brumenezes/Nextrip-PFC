# Banco de dados principal
DATABASE_URL=postgresql+psycopg://nextrip_user:SUBSTITUA_PELA_SENHA@localhost:5433/nextrip_db

# Banco de dados de testes
TEST_DATABASE_URL=postgresql+psycopg://nextrip_user:SUBSTITUA_PELA_SENHA@localhost:5433/nextrip_test_db

# Origens permitidas para o frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Ative somente em produção, quando a API estiver publicada exclusivamente por HTTPS.
ENABLE_HSTS=false

# Autenticação. Gere um valor aleatório forte e não versione o valor real.
JWT_SECRET_KEY=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE
JWT_EXPIRE_MINUTES=60

# Matriz viária. Se indisponível, o gerador usa Haversine automaticamente.
OSRM_BASE_URL=https://router.project-osrm.org
